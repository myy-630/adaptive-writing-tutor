DATABASE_URL=postgresql+psycopg://localhost:5432/adaptive_writing_tutor
LOG_LEVEL=INFO
# Optional Student State update parameters (defaults shown):
BKT_INITIAL_MASTERY=0.2
BKT_LEARN=0.05
BKT_GUESS=0.2
BKT_SLIP=0.1
ABILITY_INITIAL_SCORE=0.5
ABILITY_EMA_ALPHA=0.3
CONFIDENCE_PRIOR_WEIGHT=3.0
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=data/indexes/model_cache
RETRIEVAL_INDEX_PATH=data/indexes/resources.npz
# Retrieval results only. Keep a private Redis password in .env if needed.
RETRIEVAL_CACHE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
RETRIEVAL_CACHE_TTL_SECONDS=300
RETRIEVAL_CACHE_TIMEOUT_SECONDS=0.2
RETRIEVAL_CACHE_RETRY_SECONDS=30
RRF_K=60
# Live Agent generation; set the key in a private environment or .env only.
MODEL_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-key
DEEPSEEK_MODEL=deepseek-flash
# Alternate provider, when explicitly selected:
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=your-key
OPENAI_MODEL=gpt-4o-mini
WORKFLOW_MAX_REGENERATIONS=2
WORKFLOW_MIN_DRAFT_WORDS=20
